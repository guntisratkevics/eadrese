# VRAA TEST environment configuration example
# Copy to .env.test and fill in your values.
# .env.test is gitignored — never commit real credentials.

DIV_WSDL_URL=https://divtest.vraa.gov.lv/Vraa.Div.WebService.UnifiedInterface/UnifiedService.svc?wsdl

# Paths to certificates inside the Docker container (mounted from .test-certs/)
DIV_CLIENT_CERT=/certs/client.crt.pem
DIV_CLIENT_KEY=/certs/client.key.pem
DIV_SIGN_CERT=/certs/client.crt.pem
DIV_SIGN_KEY=/certs/client.key.pem

# SSL verification (0 = disabled — VISS Root CA is not in the public CA store)
DIV_VERIFY_SSL=0

# Your sender e-address registered in VRAA TEST system
# Format: _PRIVATE@<reg_no> (natural/legal person) or _DEFAULT@<reg_no> (API sender)
DIV_SENDER=_PRIVATE@<YOUR_REG_NO>

# Recipient e-address for test sends
DIV_RECIPIENT=_PRIVATE@<YOUR_REG_NO>

# Registration number(s) for cert_validate and search_addressee lookups
DIV_LOOKUP_VALUES=<YOUR_REG_NO>

# Auto-confirm received messages (1 = yes, 0 = no)
DIV_CONFIRM=0

# Directory for debug output (empty = disabled)
DIV_DEBUG_DIR=

# Message content for the send example
DIV_MSG_SUBJECT="PHP SDK test message"
DIV_MSG_BODY="This is a test message from the PHP eadrese SDK."

# Message ID for the get_message example (fill in after a successful send)
DIV_MSG_ID=
DIV_MESSAGE_ID=

# Extra defaults used by the Docker runner
DIV_RECIPIENTS=
DIV_LOOKUP_VALUE=
DIV_NOTIFICATION_IDS=
DIV_MAX_RESULT_COUNT=10
DIV_MAX_ITEMS=50
DIV_ADDRESSEE_UNIT_ID=
DIV_LAST_VERSION=
DIV_ALL_PAGES=1
DIV_PRINT_MAX=5
DIV_EADDRESSES=
DIV_EADDRESS_TYPE=
DIV_INCLUDE_RESTRICTED_OPS=0
DIV_RUN_SEND=1
DIV_RUN_EINVOICE=1
DIV_RUN_RECEIVE=1
DIV_RUN_SERVER_CONFIRM=1
